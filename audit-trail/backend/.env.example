# Copy to backend/.env . Never commit the real file.
# Every value below has a working default in src/config/env.js.

NODE_ENV=development
PORT=4001
LOG_LEVEL=info

# 'mongo' uses a real MongoDB. 'memory' runs the whole system in-process with no
# database at all - useful for a demo or a quick look, not durable.
PERSISTENCE=mongo

# Use a least-privilege user in anything but local development. The role
# definition is in docs/database/DATABASE.md - the application account is granted
# insert and find on the events collection, deliberately not update or remove.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=audit_trail

# Comma-separated origins, or * to allow any (development only).
CORS_ORIGIN=http://localhost:5173

# --- Authentication -------------------------------------------------------
# AUTH_ENABLED=false removes the requirement for a session. The automated
# tests use it; do not use it anywhere reachable from a network.
AUTH_ENABLED=true
# Signs session tokens. Leave blank in development and one is generated per
# boot, which means every session ends when the backend restarts. Set a long
# random value in any real deployment so sessions survive a restart.
AUTH_TOKEN_SECRET=
# Session lifetime in milliseconds. 12 hours - about one working shift.
AUTH_TOKEN_TTL_MS=43200000
# Creates the two demo accounts the sign-in page offers (operator/operator123
# and viewer/viewer123) if they do not already exist. Their passwords are
# published, so this is off by default and must stay off anywhere reachable
# from a network. Existing accounts are never overwritten.
AUTH_SEED_DEMO_ACCOUNTS=false


# The projection worker. Runs inside the API process by default so `npm start`
# gives a working system in one terminal. Set WORKER_IN_PROCESS=false and run
# `npm run start:worker` separately to deploy it independently.
WORKER_ENABLED=true
WORKER_IN_PROCESS=true
WORKER_POLL_INTERVAL_MS=500
WORKER_BATCH_SIZE=200
WORKER_MAX_RETRIES=5
WORKER_RETRY_BACKOFF_MS=250
WORKER_NAME=shipment-projection-worker

# In-process, so limits are per-instance. A multi-instance deployment would move
# this to Redis.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300

MAX_EVENTS_PER_QUERY=5000
MAX_SHIPMENTS_PER_PAGE=100

# ---------------------------------------------------------------------------
# Automatic temperature monitoring
# ---------------------------------------------------------------------------
# Where temperature readings come from. This project has no physical reefer
# attached to it, so the honest options are:
#
#   simulated  A deterministic reefer model. Every reading it produces is
#              stamped source=SIMULATED in its immutable payload and is labelled
#              "Simulated (not measured)" in the chart, the timeline and the PDF.
#              Good for demonstrating hourly monitoring and the alert path.
#   external   Fetches from a real feed at SENSOR_FEED_URL. A malformed or
#              unreachable response records nothing rather than guessing.
#   none       Records nothing. The correct setting for a deployment with no
#              sensors: silence rather than fiction.
SENSOR_SOURCE=simulated
SENSOR_MONITOR_ENABLED=true
SENSOR_FEED_URL=
SENSOR_FEED_TIMEOUT_MS=5000

# The required hourly cadence. Lower it (e.g. 60000) to demonstrate faster.
SENSOR_INTERVAL_MS=3600000

# How often the monitor looks for shipments due a reading.
SENSOR_SWEEP_INTERVAL_MS=60000

# Bounds catch-up after downtime, so a restart cannot flood a stream.
SENSOR_MAX_CATCHUP=48

# How often the simulator produces an out-of-range excursion (0-1).
SENSOR_EXCURSION_CHANCE=0.08

# ---------------------------------------------------------------------------
# Real-time updates (server-sent events)
# ---------------------------------------------------------------------------
# The dashboard subscribes to a notification stream and re-runs its ordinary
# queries when something changes. Disable it and the UI falls back to polling.
REALTIME_ENABLED=true
REALTIME_HEARTBEAT_MS=25000
